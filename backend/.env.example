# ==========================================================================
# Reality Lock backend — environment template.
# Copy to `.env` (gitignored) and adjust. Every value is OPTIONAL in dev; the
# server falls back to the documented defaults in src/config/index.js. Nothing
# is hardcoded in source — all runtime config is read from here / process.env.
# ==========================================================================

NODE_ENV=development
PORT=3000

# Comma-separated CORS allow-list. '*' is convenient for local dev only.
ALLOWED_ORIGINS=*

# Max proof-package JSON body size, in bytes (default 2 MiB).
MAX_JSON_BYTES=2097152

# --- Abuse limits (Phase 6 hardening) ---
# The service has no authentication, so per-IP rate limiting is the only control
# in front of it.
#
# TRUST_PROXY_HOPS is the number of reverse proxies between the internet and this
# process, and it is security-relevant: it must NEVER be `true`. Under Express's
# `trust proxy: true` the client address is taken from the left-most
# X-Forwarded-For entry, which the caller writes — so any attacker can rotate it
# per request and bypass the limiter entirely. A hop count makes Express read
# from the RIGHT, where only a real proxy can append. The config rejects `true`
# and negative values rather than coercing them.
#
# 1 = a single platform load balancer (the usual PaaS shape). Verify it against
# the real deployment; too high and the limiter keys on a spoofable value, too
# low and every caller collapses into one bucket.
TRUST_PROXY_HOPS=1

# Window and per-IP allowance for /proof and /verify, which share one bucket.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# /health gets its own, far looser bucket. It is not exempt (it lists the store
# on each call) but the hosting platform polls it, and answering that checker
# with 429 would mark the service unhealthy and take it out of rotation.
RATE_LIMIT_HEALTH_MAX=600

# Where the rate limiter keeps its counters. Unset means per-process memory,
# which is correct for exactly one process and wrong for any other number.
# Probing the live deployment on 2026-08-06 found THREE independent counters
# behind one hostname, so the real allowance was about 3x the configured one.
# Set this to make the configured limit the true limit.
# REDIS_URL=redis://localhost:6379

# --- Read authorisation on the endpoints that disclose content ---
# GET /proof/:eventId returns the package (which carries GPS); /media returns the
# photograph. With this ON they require proof that the caller holds the key that
# signed the package. Off, the only control is knowing a UUID — a capability that
# cannot be revoked and leaks the moment it reaches a log or a screenshot.
# GET /verify/:eventId is unaffected and stays public: a verdict discloses no
# coordinates, and independent verifiability is the point of the system.
# Only true/false/1/0/yes/no/on/off are accepted; a typo stops the process
# rather than silently failing open.
PROOF_READ_AUTH=true

# How far a signed read request's timestamp may sit from the server clock.
# The nonce cache is per-process, so this window is what actually bounds a
# replay of a captured Authorization header.
PROOF_READ_AUTH_SKEW_SECONDS=300

# Absolute path override for the shared proof-package schema.
# Defaults to <repo>/docs/design/proof-package.schema.json — normally leave unset.
# PROOF_SCHEMA_PATH=

# Absolute path override for the reference proof package checked by
# `npm run validate:schema`.
# Defaults to <repo>/docs/design/examples/proof-package.example.json.
# PROOF_EXAMPLE_PATH=

# --- Firebase (Phase 5 — leave blank until configured; see ../SETUP.md) ---
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
