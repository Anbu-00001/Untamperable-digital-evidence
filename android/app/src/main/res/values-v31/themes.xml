<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen: navy field with the shield, instead of the
         default white screen and generic robot. -->
    <style name="Theme.RealityLock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rl_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/rl_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
