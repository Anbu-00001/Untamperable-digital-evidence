    <!-- ==================== Verification result (Phase 5) ====================
         The per-check breakdown is the product here, not a single Valid/Tampered
         badge: "the media was altered" and "we had no copy of the media" are
         different statements and must stay distinguishable. -->
    <string name="verify_action">Verify</string>
    <string name="verify_running">Verifying…</string>
    <string name="verify_title">Authenticity result</string>
    <string name="verify_verdict_verified">VERIFIED</string>
    <string name="verify_verdict_failed">TAMPERED</string>
    <string name="verify_verdict_incomplete">INCOMPLETE</string>
    <string name="verify_verdict_invalid_format">NOT A VALID PROOF PACKAGE</string>
    <string name="verify_verdict_unknown">UNKNOWN</string>
    <!--
      For a certificate exported before the event was ever verified. Deliberately
      NOT verify_verdict_unknown ("UNKNOWN"), whose body says the verifier returned
      something unrecognised — that would describe a verification that happened and
      confused us, rather than one that never ran.
    -->
    <string name="certificate_verdict_not_verified">NOT VERIFIED</string>
    <string name="certificate_checks_absent">This event has not been verified against the verification service, so there is no per-check breakdown to print.</string>
    <string name="verify_verdict_verified_body">Every decisive check passed: the media and metadata are unaltered since capture and were signed by the key this package names.</string>
    <string name="verify_verdict_failed_body">At least one check failed. This package does not hold together — see the breakdown below for exactly which part.</string>
    <string name="verify_verdict_incomplete_body">Nothing failed, but a decisive check could not be run — most often because the backend does not have the media yet. Sync this event and verify again.</string>
    <string name="verify_verdict_invalid_format_body">The document does not satisfy the proof-package schema, so it could not be checked at all.</string>
    <string name="verify_verdict_unknown_body">The verifier returned a verdict this app version does not recognise.</string>
    <string name="verify_checks_title">Checks</string>
    <string name="verify_notes_title">Details</string>
    <string name="verify_advisories_title">Advisories</string>
    <string name="verify_limitations_title">What this does and does not prove</string>
    <string name="verify_unreachable">Could not reach the verifier: %1$s</string>
    <string name="verify_outcome_pass">pass</string>
    <string name="verify_outcome_fail">FAIL</string>
    <string name="verify_outcome_unavailable">not checkable</string>
    <string name="verify_outcome_unknown">unrecognised</string>
    <string name="verify_close">Close</string>

