         screen someone may photograph or share; the signed package is untouched. -->
    <string name="evidence_location_precision_note">Shown to three decimal places (~100 m). The exact coordinate stays in the proof package and is never rounded there.</string>
    <string name="evidence_location_absent">not recorded — no location was available at capture, and none was guessed</string>
    <string name="evidence_location_mock">Mock location detected at capture</string>
    <!-- manufacturer, model, Android API level -->
    <string name="evidence_device_format">%1$s %2$s · Android API %3$d</string>

