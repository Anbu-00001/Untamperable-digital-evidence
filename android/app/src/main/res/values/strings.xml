    <string name="analyze_flag_makernote">MakerNote absent while other camera metadata is present</string>
    <string name="analyze_flag_no_exif">No EXIF metadata at all (often stripped by editors or messaging apps)</string>
    <string name="analyze_flag_gps">GPS coordinates present in metadata</string>

